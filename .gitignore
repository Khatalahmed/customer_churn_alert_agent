# churn_predictions.json and agent_trace.json are deliberately TRACKED: they
# are the output of a paid LLM run, cannot be regenerated by a build, and the
# deployed demo needs them for the Investigations and Agent Reliability pages.
# Everything else below is either regenerable (database, model, truth) or
# mutable state that must not be shared between environments.
worklist.json
action_log.json
churn_predictions_reviewed.json
contacted.json
retention_report.md

# personal interview prep (not for the public repo)
INTERVIEW_PREP.md

# frontend build output and local env
frontend/node_modules/
frontend/.next/
frontend/.env.local
