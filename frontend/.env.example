# Where the churn service lives. Read on the server only — it is never sent to
# the browser, so it needs no NEXT_PUBLIC_ prefix and leaks nothing.
#
# Local development:
CHURN_API_URL=http://127.0.0.1:8000
#
# Production (Vercel): set this to the Hugging Face Space, with no trailing
# slash, for example
# CHURN_API_URL=https://khatalahmed-churnguard-api.hf.space
#
# If it is unset the app falls back to localhost, which on a deployed host
# means every page renders "Service unreachable" — a loud failure rather than
# a blank one, on purpose.
