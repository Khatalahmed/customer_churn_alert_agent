# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- which LLM the agent uses: azure | vertex | google | groq ---
MODEL_PROVIDER=azure

# --- Azure OpenAI (keyless: run `az login` first, no API key needed) ---
# Your identity needs the "Cognitive Services OpenAI User" role on the resource.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# v1 = the current OpenAI-compatible Azure API (recommended, and the default).
# Or a dated version such as 2024-10-21 for the classic deployments API.
AZURE_OPENAI_API_VERSION=v1

# --- other providers (only needed if MODEL_PROVIDER selects them) ---
# MODEL_NAME=<model name for vertex / google / groq>
# GCP_PROJECT=
# GCP_LOCATION=global
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- optional: run-cost estimate (USD per 1M tokens, from your provider's pricing) ---
# MODEL_PRICE_IN_PER_M=
# MODEL_PRICE_OUT_PER_M=

# --- optional: LangSmith tracing ---
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=CustomerChurnAlertAgent

# --- optional: keep DB, model and outputs outside the repo ---
# CHURN_DATA_DIR=
